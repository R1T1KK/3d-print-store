# =============================================================================
# apps/web — Next.js Environment Variable Reference
# =============================================================================
# Copy this file to apps/web/.env.local for local development.
# NEVER commit .env.local with real values to version control.
# See root .env.example for full descriptions of each variable.
# =============================================================================

# Database (Required: M0+)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase — browser safe (Required: M1+)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# Supabase — server only (Required: M1+)
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# Auth session signing (Required: M1+)
AUTH_SECRET="[GENERATE-WITH-CRYPTO-RANDOMBYTES-64]"

# Mesh analysis service (Required: M2+)
MESH_SERVICE_URL="http://localhost:8000"
MESH_SERVICE_TOKEN="[GENERATE-RANDOM-TOKEN-FOR-INTERNAL-AUTH]"

# Payment — Razorpay (Required: M3+)
RAZORPAY_KEY_ID="[YOUR-RAZORPAY-KEY-ID]"
RAZORPAY_KEY_SECRET="[YOUR-RAZORPAY-KEY-SECRET]"
RAZORPAY_WEBHOOK_SECRET="[YOUR-RAZORPAY-WEBHOOK-SIGNING-SECRET]"

# Email — Resend (Deferred: Post-MVP)
EMAIL_API_KEY="[YOUR-RESEND-API-KEY]"
