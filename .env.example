# =============================================================================
# 3D Print Store — Root Environment Variable Reference
# =============================================================================
# Copy this file to .env.local (for apps/web) and fill in actual values.
# NEVER commit .env.local or any file containing real secrets to version control.
# See SECURITY.md for full secret handling policy.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE — Supabase PostgreSQL (Required: M0+)
# -----------------------------------------------------------------------------
# Prisma connection string from the Supabase project's "Database" settings page.
# Use the "Connection pooling" URI (port 6543) for serverless / edge deployments,
# or the direct URI (port 5432) for local development and migrations.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# SUPABASE — Client-side (Required: M1+)
# These two variables are safe to expose in the browser (NEXT_PUBLIC_ prefix).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# -----------------------------------------------------------------------------
# SUPABASE — Server-side only (Required: M1+)
# DO NOT prefix with NEXT_PUBLIC_. Used only in Next.js server components and
# API route handlers to bypass Row-Level Security (RLS) for admin operations.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# -----------------------------------------------------------------------------
# AUTH (Required: M1+)
# Random secret used to sign auth session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
AUTH_SECRET="[GENERATE-WITH-CRYPTO-RANDOMBYTES-64]"

# -----------------------------------------------------------------------------
# STORAGE (Required: M2+)
# These variables are only needed if using a non-Supabase S3-compatible bucket.
# If using Supabase Storage exclusively, SUPABASE_SERVICE_ROLE_KEY above is
# sufficient and these can be left blank.
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# -----------------------------------------------------------------------------
# MESH ANALYSIS SERVICE (Required: M2+)
# Internal FastAPI service URL. In local development: http://localhost:8000
# In production: the private container host URL (never public-facing).
# MESH_SERVICE_TOKEN is a shared bearer token for internal service-to-service auth.
# -----------------------------------------------------------------------------
MESH_SERVICE_URL="http://localhost:8000"
MESH_SERVICE_TOKEN="[GENERATE-RANDOM-TOKEN-FOR-INTERNAL-AUTH]"

# -----------------------------------------------------------------------------
# PAYMENT — Razorpay (Required: M3+)
# Obtain from the Razorpay Dashboard > Settings > API Keys.
# RAZORPAY_KEY_ID is safe for client-side use; the others must stay server-only.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID="[YOUR-RAZORPAY-KEY-ID]"
RAZORPAY_KEY_SECRET="[YOUR-RAZORPAY-KEY-SECRET]"
RAZORPAY_WEBHOOK_SECRET="[YOUR-RAZORPAY-WEBHOOK-SIGNING-SECRET]"

# -----------------------------------------------------------------------------
# EMAIL — Resend (Deferred: Post-MVP)
# -----------------------------------------------------------------------------
EMAIL_API_KEY="[YOUR-RESEND-API-KEY]"
